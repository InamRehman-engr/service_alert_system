# This is Doxygen configuration file
#
# Doxygen provides over 260 configuration statements
# To make this file easier to follow,
# it contains only statements that are non-default
#
# NOTE:
# It is recommended not to change defaults unless specifically required
# Test any changes how they affect generated documentation
# Make sure that correct warnings are generated to flag issues with documented code
#
# For the complete list of configuration statements see:
# http://doxygen.nl/manual/config.html


PROJECT_NAME = "Iotcore"

INPUT += ./Readme.md
USE_MDFILE_AS_MAINPAGE = ./Readme.md
## The 'INPUT' statement below is used as input by script 'gen-df-input.py'
## to automatically generate API reference list files heder_file.inc
## These files are placed in '_inc' directory
## and used to include in API reference documentation
INPUT += \
    ../../app/includes/app_iotcore.h \
    ../../app/includes/app_iotcore.h       \
    ../../app/priv_includes/app_iotcore_mqtt_cbs.h     \
    ../../app/priv_includes/app_iotcore_mqtt_pub_sub_events.h      \
    ../../app/priv_includes/app_iotcore_network_event_handler.h        \
    ../../app/priv_includes/app_iotcore_ota_event_handler.h        \
    ../../core/battery_charging/battery_charging.h     \
    ../../core/billing/billing.h       \
    ../../core/events/data_events/data_modals/mqtt_data_model.h        \
    ../../core/events/data_events/iotcore_data_events.h        \
    ../../core/events/error_events/iotcore_error_events.h      \
    ../../core/events/app_events/data_modals/system_info_data_model.h     \
    ../../core/events/app_events/iotcore_app_events.h        \
    ../../core/events/iotcore_events.h     \
    ../../core/iotcore_server_apis/iotcore_server_apis.h       \
    ../../networking/connectivity/ble/app_ble.h        \
    ../../networking/connectivity/connectivity.h       \
    ../../networking/connectivity/connectivity_overrides.h     \
    ../../networking/connectivity/ethernet/ethernet.h      \
    ../../networking/connectivity/gsm/sim868_gps.h     \
    ../../networking/connectivity/modem/gnss_provider/nmea_parser.h        \
    ../../networking/connectivity/modem/modem.h        \
    ../../networking/connectivity/network_ping/ping.h      \
    ../../networking/connectivity/wifi/wifi_manager.h      \
    ../../networking/connectivity/wifi/wifi_manager_provisioning_api.h     \
    ../../networking/connectivity/wifi/wifi_utils.h        \
    ../../networking/protocols/http/http_server/http_server_local.h        \
    ../../networking/protocols/mqtt/app_mqtt.h     \
    ../../networking/protocols/REST_API_CLIENT/include/http_event_handler.h        \
    ../../networking/protocols/REST_API_CLIENT/include/http_rest_client.h      \
    ../../networking/protocols/REST_API_CLIENT/include/http_rest_json_client.h     \
    ../../networking/protocols/REST_API_CLIENT/include/http_rest_types.h       \
    ../../networking/protocols/sockets/tcp_server.h        \
    ../../networking/vhmi/vhmi.h       \
    ../../output_devices/displays/led/app_led.h        \
    ../../output_devices/displays/ws2812b/ws2812b_led_strip.h      \
    ../../storage/non_vol_storage/nvs/nvs_read_write.h     \
    ../../storage/non_vol_storage/spiffs/iot_core_spiffs.h     \
    ../../storage/sdcard/sd_card.h     \
    ../../storage/volatile_storage/dictionary/dictionary.h     \
    ../../system/firmware_updates/firmware_check/firmware_check.h      \
    ../../system/firmware_updates/http_ota_handler/base64_decoding/base64_decoding.h       \
    ../../system/firmware_updates/http_ota_handler/http_ota_handler.h      \
    ../../system/firmware_updates/native_ota/native_ota.h      \
    ../../system/status_monitoring/system_monitoring.h     \
    ../../system/status_reporting/system_status_reporting.h        \
    ../../system/sysinfo/sysinfo.h     \
    ../../utils/dc_codes/DC-codes.h        \
    ../../utils/error_handling/data_modals/iotcore_errors_data_model.h     \
    ../../utils/error_handling/errorHandling.h     \
    ../../utils/json/myJSON.h      \
    ../../utils/url_encoding/url_encoding.h        \
    ../../utils/utility/utility.h      \
    ../../hardware/sensors/current/ina219/INA219.h      \
    ../../hardware/sensors/current/ina226/ina226.h      \
    ../../hardware/sensors/position_sensor/AS5045/AS5045.h      \
    ../../hardware/peripherals/uart/uart_driver.h      \

## Get warnings for functions that have no documentation for their parameters or return value
##
WARN_NO_PARAMDOC = YES

## Enable preprocessing and remove __attribute__(...) expressions from the INPUT files
##
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = \
    $(ENV_DOXYGEN_DEFINES) \
    __DOXYGEN__=1 \
    __attribute__(x)= \
    _Static_assert()= \
    ESP_STATIC_ASSERT()= \
    IDF_DEPRECATED(X)= \
    IRAM_ATTR= \
    FORCE_INLINE_ATTR= \
    configSUPPORT_DYNAMIC_ALLOCATION=1 \
    configSUPPORT_STATIC_ALLOCATION=1 \
    configQUEUE_REGISTRY_SIZE=1 \
    configUSE_RECURSIVE_MUTEXES=1 \
    configTHREAD_LOCAL_STORAGE_DELETE_CALLBACKS=1 \
    configNUM_THREAD_LOCAL_STORAGE_POINTERS=1 \
    configUSE_APPLICATION_TASK_TAG=1 \
    configTASKLIST_INCLUDE_COREID=1 \
    PRIVILEGED_FUNCTION= \
    "ESP_EVENT_DECLARE_BASE(x)=extern esp_event_base_t x"

## Do not complain about not having dot
##
HAVE_DOT = NO

## Generate XML that is required for Breathe
##
GENERATE_XML    = YES
XML_OUTPUT      = xml

GENERATE_HTML   = NO
HAVE_DOT        = NO
GENERATE_LATEX  = NO
GENERATE_MAN    = YES
GENERATE_RTF    = NO

## Skip distracting progress messages
##
QUIET = YES

## Enable Section Tags for conditional documentation
##
ENABLED_SECTIONS += DOC_EXCLUDE_HEADER_SECTION  ## To conditionally remove doc sections from IDF source files without affecting documentation in upstream files.
ENABLED_SECTIONS += DOC_SINGLE_GROUP            ## To conditionally remove groups from the documentation and create a 'flat' document without affecting documentation in upstream files.

OUTPUT_DIRECTORY = _build
EXTRACT_ALL = YES
RECURSIVE = YES