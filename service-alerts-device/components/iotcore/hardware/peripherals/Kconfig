                    bool "UTC+12:00"
                config TIMEZONE_UTC_PLUS_12_45
                    bool "UTC+12:45"
                config TIMEZONE_UTC_PLUS_13
                    bool "UTC+13:00"
                config TIMEZONE_UTC_PLUS_14
                    bool "UTC+14:00"
            endchoice
    endmenu
