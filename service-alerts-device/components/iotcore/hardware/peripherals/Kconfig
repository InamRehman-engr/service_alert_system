                    bool "UTC+04:00"
                config TIMEZONE_UTC_PLUS_4_30
                    bool "UTC+04:30"
                config TIMEZONE_UTC_PLUS_5
                    bool "UTC+05:00"
                config TIMEZONE_UTC_PLUS_5_30
                    bool "UTC+05:30"
                config TIMEZONE_UTC_PLUS_5_45
                    bool "UTC+05:45"
                config TIMEZONE_UTC_PLUS_6
                    bool "UTC+06:00"
                config TIMEZONE_UTC_PLUS_6_30
                    bool "UTC+06:30"
                config TIMEZONE_UTC_PLUS_7
                    bool "UTC+07:00"
                config TIMEZONE_UTC_PLUS_8
                    bool "UTC+08:00"
                config TIMEZONE_UTC_PLUS_8_45
                    bool "UTC+08:45"
                config TIMEZONE_UTC_PLUS_9
