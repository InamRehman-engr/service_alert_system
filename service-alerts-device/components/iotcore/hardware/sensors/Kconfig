    menu "Gas Sensors"
        config ENABLE_MC106
            bool "Enable MC106 Sensor"
            default n

            config MC106_ADC_UNIT
                int "ADC Unit"
                depends on ENABLE_MC106
                default 2
            config MC106_ADC_CHANNEL_A
                int "ADC Unit"
                depends on ENABLE_MC106
                default 1
            config MC106_ADC_CHANNEL_B
                int "ADC Unit"
                depends on ENABLE_MC106
                default 2

        config ENABLE_MICS5524
            bool "Enable MICS5524 Sensor"
            default n

            config MiCS_5524_ADC_UNIT
                int "ADC Unit"
                default 1
                depends on ENABLE_MICS5524

            config MiCS_5524_ADC_CHANNEL
                int "ADC Unit"
                default 1
                depends on ENABLE_MICS5524


        config ENABLE_MP5
            bool "Enable MP5 Sensor"
            default n

            config MP_5_ADC_UNIT
                int "ADC Unit"
                depends on ENABLE_MP5
                range 1 2
                default 2

            config MP_5_ADC_CHANNEL_A
                int "ADC Unit"
                depends on ENABLE_MP5
                default 1

            config MP_5_ADC_CHANNEL_B
                int "ADC Unit"
                depends on ENABLE_MP5
                default 2

            
        config ENABLE_MQ7B
