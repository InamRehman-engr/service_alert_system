                bool "Release Candidate"
                default n
        config FW_RC_NUM
                int "Release Candidate Version"
                default 0 
        config  DEVICE_HARDWARE_PREFIX #Ifdef checks should be comparing strings
                string "Hardware prefix. will be set as IAW_1.x where IAW is prefix"
                default "HW"

        config  HARDWARE_VERSION
                string "hardware version"
                default "1.x"
                help
                    hardware verison for which this c.

        config  DEVICE_TYPE_ID
