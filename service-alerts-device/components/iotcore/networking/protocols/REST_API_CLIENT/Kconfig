menu "HTTP REST Client"

  config HTTP_REST_CLIENT_USER_AGENT
    string "User Agent"
    default "IDF HTTP REST Client/1.0"
    help
      This is the User Agent string to be used by the client.

  config HTTP_REST_CLIENT_RECEIVE_BUFFER_SIZE
    int "Receive Buffer Size"
    default 512
    help
      HTTP REST client receive buffer size

  config HTTP_REST_CLIENT_USE_LOCK  
    bool "Use lock to allow single client request at a time"  
    default y  
    help  
      Enable this option to use a semaphore for managing HTTP REST client requests.  
      When enabled, only one request will be processed at a time.  
    
endmenu
